# Copy to studio/.env and fill in.

# Password for the web interface. Required.
STUDIO_PASSWORD=

# Token the reading server sends to fetch personas (Authorization: Bearer ...). Required.
# Generate one with: openssl rand -hex 32
STUDIO_READ_TOKEN=

# Signs login cookies. Without it, everyone is signed out when the studio restarts.
STUDIO_SESSION_SECRET=

# Set to 1 when serving over HTTPS.
COOKIE_SECURE=0

PORT=8790
# Where the SQLite database lives.
STUDIO_DATA_DIR=./data
# On first start, with an empty database, import the markdown personas from this folder.
STUDIO_SEED_DIR=../server/psychics
# Psychics without a photo get the one bundled with the iOS app from here (psychic_<id>.png), once.
STUDIO_PHOTO_DIR=../AsFate/Resources
