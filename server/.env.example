# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
# DEVICE_DAILY_LIMIT=40
# IP_DAILY_LIMIT=200

# Optional: fetch personas from Psychic Studio (studio/) instead of the files in psychics/.
# The token is the studio's STUDIO_READ_TOKEN. Personas refresh every minute; the files are the fallback.
# PERSONA_STUDIO_URL=http://localhost:8790
# PERSONA_STUDIO_TOKEN=

# Encrypts card spreads while they're being turned one by one. Any long random string; keep it the same
# across restarts and deploys, or spreads in progress can't be continued. Generate one with: openssl rand -hex 32
# DRAW_SECRET=
